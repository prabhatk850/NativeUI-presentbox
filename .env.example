# Copy to .env (git-ignored) and fill in. Space ID and environment live in src/cms/config.json.
# Without a delivery token the app runs on the fixtures in src/mocks.

# Contentful → Settings → API keys → "Content Delivery API - access token".
# Read-only; it is built into the app bundle. Restart Metro / Vite after changing it.
CONTENTFUL_DELIVERY_TOKEN=

# Contentful → Settings → CMA tokens. Only `npm run cms:seed` uses it; never bundled, never commit it.
CONTENTFUL_MANAGEMENT_TOKEN=
